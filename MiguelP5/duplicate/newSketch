function setup() {
  createCanvas(100, 100);

  describe("A white square. The mouse's x- and y-coordinates are displayed as the user moves the mouse.");
}

function draw() {
  background('red');

  // Style the text.
  textAlign(CENTER);
  textSize(16);

  // Display the mouse's coordinates.
  text(`x: ${mouseX} y: ${mouseY}`, 50, 50);
}